--! The lobby keeps the preview separate from the live authoritative arena.

import Arena
import Cmd exposing (Cmd)
import Html exposing (Html)
import Live
import Palette exposing (Color)
import Sub exposing (Sub)
import Tea


type alias Model =
    name : String
    color : Color.Type
    moving : Bool
    grid : Bool
    help : Bool
    preview : Bool
    live : Live.Model


type Msg
    = NameChanged String
    | ColorChanged Color.Type
    | ToggleMotion
    | ToggleGrid
    | ToggleHelp
    | TogglePreview
    | EnterArena
    | LiveMsg Live.Msg


nameLimit : Int
nameLimit = 18


init : ⊤ → Model × Cmd Msg
init ⊤ =
    ( { name = ""
      , color = Color.Moss
      , moving = True
      , grid = True
      , help = False
      , preview = False
      , live = Live.init
      }
    , Cmd.none
    )


update : Msg, Model → Model × Cmd Msg
update msg model =
    case msg of
        NameChanged name →
            ( { model | name = String.left name nameLimit }, Cmd.none )
        ColorChanged color →
            ( { model | color = color }, Cmd.none )
        ToggleMotion →
            ( { model | moving = not model.moving }, Cmd.none )
        ToggleGrid →
            ( { model | grid = not model.grid }, Cmd.none )
        ToggleHelp →
            ( { model | help = not model.help }, Cmd.none )
        TogglePreview →
            ( { model | preview = not model.preview }, Cmd.none )

        EnterArena →
            ( live, command ) = Live.start (playerName model.name) model.color model.live
            ( { model | live = live }, Cmd.map command "live-arena" LiveMsg )
        LiveMsg message →
            ( live, command ) = Live.update message model.live
            ( { model | live = live }, Cmd.map command "live-arena" LiveMsg )


view : Model → Html Msg
view model =
    <div class="site-shell" style={Palette.variables}>
        <header class="site-header">
            <a class="brand" href="/" aria-label="Snake Arena home">
                <svg viewBox="0 0 40 40" aria-hidden="true">
                    <path
                        d="M 8 30 L 23 30 C 35 30 35 18 23 18 L 16 18 C 5 18 5 6 16 6 L 31 6"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="8"
                        stroke-linecap="round"
                    />
                    <circle cx="30" cy="4" r="1.4" fill="#eff0e8" />
                </svg>
                <span>SNAKE<span class="brand-light">ARENA</span></span>
            </a>
            <span class="header-note">A SMALL GAME. A BIG APPETITE.</span>
            <button class="help-button" onClick={ToggleHelp} aria-expanded={boolText model.help}>
                {if model.help then "Close guide" else "How to play"} <span aria-hidden="true">↗</span>
            </button>
        </header>
        <main>
            <section class="page-heading">
                <div>
                    <p class="eyebrow">GROW INTO TROUBLE</p><h1>Eat. Grow. <span>Stay alive.</span></h1>
                </div>
                <div class="build-tag">
                    <span class="status-dot" /> {if model.live.active then
                                                    "LIVE MULTIPLAYER"
                                                 else
                                                    "ARENA PREVIEW"
                                                } <span class="edition">/ 001</span>
                </div>
            </section>
            <div class={if model.preview then "game-layout wide-preview" else "game-layout"}>
                <section class="arena-section" aria-label="Arena preview">
                    {if model.live.active then
                        Html.map (Live.view model.live) LiveMsg
                     else
                        Arena.view model.color model.moving model.grid
                    }
                    <div
                        class={if model.live.active then
                                  "arena-toolbar live-toolbar"
                               else
                                  "arena-toolbar"
                              }
                    >
                        <span class="toolbar-label">
                            <span class="hollow-dot" /> {if model.live.active then
                                                            "LIVE ARENA"
                                                         else
                                                            "TAKE A LOOK AROUND"
                                                        }
                        </span>
                        <div class="toolbar-actions">
                            <button onClick={ToggleGrid} aria-pressed={boolText model.grid}>
                                {if model.grid then "Hide grid" else "Show grid"}
                            </button>
                            <button onClick={ToggleMotion} aria-pressed={boolText model.moving}>
                                {if model.moving then "Pause motion" else "Resume motion"}
                            </button>
                            <button
                                class="expand-button"
                                onClick={TogglePreview}
                                aria-expanded={boolText model.preview}
                            >
                                {if model.preview then "Show lobby ↙" else "Expand ↗"}
                            </button>
                        </div>
                    </div>
                </section>
                <aside class="lobby" aria-label="Player setup">
                    <div class="lobby-heading">
                        <span class="eyebrow">MEET YOUR SNAKE</span><span class="section-number">01 /</span>
                    </div>
                    <div class={"portrait-wrap " ++ Palette.className model.color}>
                        {Arena.portrait model.color}
                    </div>
                    <div class="player-title">
                        <h2>{playerName model.name}</h2><span>{Palette.name model.color}</span>
                    </div>
                    <div class="name-field">
                        <label for="player-name">Your name</label>
                        <input
                            id="player-name"
                            type="text"
                            value={model.name}
                            onInput={NameChanged}
                            maxlength={nameLimit}
                            placeholder="Little trouble"
                            autocomplete="off"
                        />
                    </div>
                    <fieldset class="color-field">
                        <legend>Pick a color</legend>
                        <div class="color-options">
                            <For each={Palette.colors} keyed={False}>
                                {λcolor →
                                    <button
                                        class={"color-button " ++ Palette.className color}
                                        aria-label={Palette.name color}
                                        aria-pressed={boolText (model.color == color)}
                                        onClick={ColorChanged color}
                                    >
                                        <span class="color-swatch" />
                                        <span class="color-check" aria-hidden="true">
                                            {if model.color == color then "✓" else ""}
                                        </span>
                                    </button>
                                }
                            </For>
                        </div>
                    </fieldset>
                    <button class="join-button" onClick={EnterArena}>
                        Enter arena <span aria-hidden="true">↗</span>
                    </button>
                    <p class="connection-note">
                        <span class="hollow-dot" /> {model.live.note}
                    </p>
                    <div class="lobby-divider" />
                    <div class="lobby-footnote">
                        <span class="small-spark">✳</span><p>Start small.<br />Leave a long impression.</p>
                    </div>
                </aside>
            </div>
            {if model.help then guide else <span />}
            <section class="rules-strip" aria-label="Game rules">
                {rule "01" "Follow your appetite." "Collect food to grow your snake." "food-icon"}
                {rule
                    "02"
                    "Keep your head clear."
                    "Touch another snake's body and you are out."
                    "turn-icon"
                }
                {rule "03" "Make a comeback." "Fallen snakes become food. Join again." "loop-icon"}
            </section>
        </main>
        <footer class="site-footer">
            <span>BUILT IN <strong>BENI</strong></span><span>JUST ONE MORE ROUND.</span><span>{if model.live.active then "LIVE · AUTHORITATIVE SERVER" else "PREVIEW · NO LIVE PLAYERS"}</span>
        </footer>
    </div>


playerName : String → String
playerName name =
    cleaned = String.trim name
    if String.isEmpty cleaned then "Little trouble" else cleaned


boolText : Bool → String
boolText flag = if flag then "true" else "false"


rule : String, String, String, String → Html Msg
rule number title description icon =
    <article class="rule-card">
        <span class={"rule-icon " ++ icon} aria-hidden="true"><span /></span>
        <div><span class="rule-number">{number}</span><h3>{title}</h3><p>{description}</p></div>
    </article>


guide : Html Msg
guide =
    <section class="guide" aria-label="How to play">
        <div><p class="eyebrow">THE SHORT VERSION</p><h2>Aim for food. Avoid the bodies.</h2></div>
        <p>
            In the arena, move the mouse or drag a finger to steer. Your snake moves all the time.
            Eat food to grow. If your head touches another snake, your run ends.
        </p>
        <p>
            Choose a name and color. Enter arena connects to the local Worker. The preview remains an illustration.
        </p>
        <button class="help-button" onClick={ToggleHelp}>
            Got it <span aria-hidden="true">✓</span>
        </button>
    </section>


main : Tea.Program
main = Tea.element { init = init, update = update, view = view, subscriptions = subscriptions }


subscriptions : Model → Sub Msg
subscriptions model = Sub.map (Live.subscriptions model.live) LiveMsg
