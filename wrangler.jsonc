{
  "name": "beno-arena",
  "main": "build/worker/_worker.mjs",
  "compatibility_date": "2026-05-18",
  "compatibility_flags": [
    "enable_request_signal"
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "ARENAS",
        "class_name": "Arena"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "Arena"
      ]
    }
  ],
  "assets": {
    "directory": "build/page",
    "binding": "ASSETS",
    "run_worker_first": [
      "/arena/*",
      "/health"
    ]
  },
  "dev": {
    "ip": "127.0.0.1",
    "port": 4173
  },
  "previews": {
    "durable_objects": {
      "bindings": [
        {
          "name": "ARENAS",
          "class_name": "Arena"
        }
      ]
    }
  },
  "build": {
    "command": "scripts/build.sh"
  },
  "env": {
    "production": {
      "name": "beno-arena",
      "preview_urls": true,
      "compatibility_date": "2026-10-23",
      "durable_objects": {
        "bindings": [
          {
            "name": "ARENAS",
            "class_name": "Arena"
          }
        ]
      },
      "routes": [
        {
          "pattern": "beno-arena.jayson.com.br",
          "zone_id": "8d0edd3d1caa80ae506e13d36b6d5764",
          "custom_domain": true
        }
      ]
    }
  }
}
