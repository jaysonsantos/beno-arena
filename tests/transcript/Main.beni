--! Check the unchanged upstream Miniflare driver's transcript through the shared packet schema.

import Io
import Node
import ProbeTests
import Protocol
import Transcript as Probe


main : Node.Program
main = Io.run λ⊤ →
    case Io.readFile ".scratch/workers/current.log" of
        Err _ →
            Node.exitWith "FAIL: the Worker transcript is absent." 1
        Ok transcript →
            alice = Probe.snapshots transcript "alice"
            bob = Probe.snapshots transcript "bob"
            carol = Probe.snapshots transcript "carol"
            firstAlice = List.head alice
            firstBob = List.head bob
            idsDiffer =
                case ( firstAlice, firstBob ) of
                    ( Just a, Just b ) →
                        a.you ≠ b.you
                    _ →
                        False
            scores = Maybe.withDefault (Maybe.map firstAlice .scores) []
            names = List.sort (List.map scores .name)
            otherNames =
                Maybe.withDefault (Maybe.map (List.head carol) λs → List.map s.scores .name) []
            all = [ …alice, …bob, …carol ]
            checks =
                [ ( "two clients receive both ticks"
                  , List.length alice == 2 && List.length bob == 2
                  )
                , ( "both clients see the same tick sequence"
                  , List.map alice .tick == [ 1, 2 ] && List.map bob .tick == [ 1, 2 ]
                  )
                , ( "the clients have separate identities", idsDiffer )
                , ( "the players stay alive", List.all all .alive )
                , ( "the arena shares its scores", names == [ "Alice", "Bob" ] )
                , ( "another arena has separate scores", otherNames == [ "Carol" ] )
                , ( "another arena starts at tick one", List.map carol .tick == [ 1 ] )
                , ( "snapshots contain visible food", List.all all Probe.visibleFood )
                , ( "invalid input returns an error"
                  , List.any (Probe.packets transcript "bob") Probe.rejected
                  )
                , ( "cross-site upgrades fail"
                  , String.contains transcript "(socket foreign) < 403"
                  )
                , ( "an idle object has no tick", String.contains transcript "< 409" )
                , ( "invalid input closes with 1008"
                  , String.contains transcript "< (socket bob) close 1008 "
                  )
                , ( "each client receives one welcome"
                  , List.all [ "alice", "bob", "carol", "idle" ] λclient →
                      Probe.welcomes transcript client == 1
                  )
                , ( "each player receives one joined reply"
                  , List.all [ "alice", "bob", "carol" ] λclient →
                      Probe.joins transcript client == 1
                  )
                , ( "the idle client receives no joined reply", Probe.joins transcript "idle" == 0 )
                , ( "the newest aim of a tick wins", Probe.aimsNewest alice )
                , ( "client close handshakes complete"
                  , Probe.closeReply transcript "alice" 1000
                      && Probe.closeReply transcript "carol" 4001
                      && Probe.closeReply transcript "idle" 1000
                  )
                , ( "no request times out", not (String.contains transcript "no response in") )
                , ( "the runtime has no errors", not (String.contains transcript "| err:") )
                , …ProbeTests.checks
                ]
            output =
                String.join
                    (List.map checks λ( name, passed ) →
                        (if passed then "PASS: " else "FAIL: ") ++ name
                    )
                    "\n"
            Node.exitWith output (if List.all checks λresult → result.1 then 0 else 1)
