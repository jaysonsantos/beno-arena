--! Snake colors shared by the lobby and arena preview.

pub type Color
    = Moss
    | Tangerine
    | Sky
    | Lilac


pub colors : List Color
colors = [ Moss, Tangerine, Sky, Lilac ]


pub name : Color → String
name color =
    case color of
        Moss →
            "Moss"
        Tangerine →
            "Tangerine"
        Sky →
            "Sky"
        Lilac →
            "Lilac"


pub paint : Color → String
paint color =
    case color of
        Moss →
            "#c5f277"
        Tangerine →
            "#ffa76e"
        Sky →
            "#89cef4"
        Lilac →
            "#c7acf1"


pub className : Color → String
className color =
    case color of
        Moss →
            "moss"
        Tangerine →
            "tangerine"
        Sky →
            "sky"
        Lilac →
            "lilac"
